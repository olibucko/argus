# Argus Security System - Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.

# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=123456789,987654321

# --- Email Alerts ---
SENDER_EMAIL=your_email@example.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# --- Camera RTSP Streams ---
# Numbering matches the order of cameras in config.json.
CAMERA_1_URL=rtsp://user:password@192.168.1.100:554/stream1
CAMERA_2_URL=rtsp://user:password@192.168.1.100:554/stream2
CAMERA_3_URL=rtsp://user:password@192.168.1.100:554/stream3
CAMERA_4_URL=rtsp://user:password@192.168.1.100:554/stream4
